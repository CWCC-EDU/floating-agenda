{
  "name": "floating-agenda",
  "version": "1.5.7",
  "private": true,
  "description": "A transparent desktop agenda with automatic task rollover.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win portable zip --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "lunar-javascript": "^1.7.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.floatingagenda.desktop",
    "productName": "浮屿",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Floating-Agenda-${version}-Windows-x64.${ext}",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ]
    },
    "portable": {
      "useZip": true
    }
  }
}
